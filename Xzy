CREATE OR REPLACE PROCEDURE PRC_POPULATE_SUSPENSE_TRACKER (
    p_run_date IN DATE DEFAULT NULL
)
IS
    l_run_date   DATE;
    l_yesterday  DATE;
BEGIN

    /* ============================================================
       1. GET RUN DATE
       ============================================================ */

    IF p_run_date IS NULL THEN

        SELECT TRUNC(MAX(etl_date))
        INTO l_run_date
        FROM etl_table;

    ELSE

        l_run_date := TRUNC(p_run_date);

    END IF;


    /* ============================================================
       VALIDATE RUN DATE
       ============================================================ */

    IF l_run_date IS NULL THEN

        RAISE_APPLICATION_ERROR(
            -20001,
            'ETL_DATE not found in ETL_TABLE'
        );

    END IF;


    l_yesterday := l_run_date - 1;


    /* ============================================================
       2. DELETE EXISTING RESULT FOR RUN DATE

       This makes the procedure safe to rerun for the same ETL date.
       ============================================================ */

    DELETE FROM suspense_tracker
    WHERE balance_date >= l_run_date
      AND balance_date <  l_run_date + 1;


    /* ============================================================
       3. INSERT FINAL RESULT
       ============================================================ */

    INSERT INTO suspense_tracker
    (
        balance_date,
        branch_code,
        currency,
        cgl,
        balance,
        inr_balance,
        type,
        first_error_date
    )

    WITH

    /* ============================================================
       TODAY'S GL BALANCE
       ============================================================ */

    today_data AS
    (
        SELECT
            gb.branch_code,
            gb.currency,
            gb.cgl,

            gb.balance      AS t_bal,
            gb.inr_balance  AS t_inr_bal

        FROM gl_balance gb

        WHERE gb.balance_date >= l_run_date
          AND gb.balance_date <  l_run_date + 1

          AND gb.cgl IN
          (
                '1111111111',
                '1111111112',
                '1260505001',
                '2148505001',
                '1148505004',
                '1148505005',
                '1148505006',
                '1148505007',
                '1148505010',
                '1148505012',
                '1148505014',
                '1148505020',
                '2148505004',
                '2148505006',
                '2148505007',
                '2148505010',
                '2148505011',
                '2148505014',
                '2148505016',
                '2148505018',
                '2148505019',
                '2148505021',
                '2148505022',
                '2148505024',
                '2148505033',
                '2148505035',
                '1260505002',
                '1260505003'
          )
    ),


    /* ============================================================
       YESTERDAY'S GL BALANCE
       ============================================================ */

    yesterday_data AS
    (
        SELECT
            gb.branch_code,
            gb.currency,
            gb.cgl,

            gb.balance      AS y_bal,
            gb.inr_balance  AS y_inr_bal

        FROM gl_balance gb

        WHERE gb.balance_date >= l_yesterday
          AND gb.balance_date <  l_yesterday + 1

          AND gb.cgl IN
          (
                '1111111111',
                '1111111112',
                '1260505001',
                '2148505001',
                '1148505004',
                '1148505005',
                '1148505006',
                '1148505007',
                '1148505010',
                '1148505012',
                '1148505014',
                '1148505020',
                '2148505004',
                '2148505006',
                '2148505007',
                '2148505010',
                '2148505011',
                '2148505014',
                '2148505016',
                '2148505018',
                '2148505019',
                '2148505021',
                '2148505022',
                '2148505024',
                '2148505033',
                '2148505035',
                '1260505002',
                '1260505003'
          )
    ),


    /* ============================================================
       4. FULL OUTER JOIN TODAY + YESTERDAY

       Same as:

       today_df.join(
           yest_df,
           how="full_outer"
       )
       ============================================================ */

    balance_compare AS
    (
        SELECT

            NVL(t.branch_code, y.branch_code) AS branch_code,
            NVL(t.currency,    y.currency)    AS currency,
            NVL(t.cgl,         y.cgl)         AS cgl,

            t.t_bal,
            t.t_inr_bal,

            y.y_bal,
            y.y_inr_bal

        FROM today_data t

        FULL OUTER JOIN yesterday_data y

            ON  t.branch_code = y.branch_code
            AND t.currency    = y.currency
            AND t.cgl         = y.cgl
    ),


    /* ============================================================
       5. TYPE LOGIC
       ============================================================ */

    typed_data AS
    (
        SELECT

            bc.branch_code,
            bc.currency,
            bc.cgl,

            bc.t_bal,
            bc.t_inr_bal,

            bc.y_bal,
            bc.y_inr_bal,


            CASE

                /* =================================================
                   FINANCIAL YEAR START

                   01-APR IS ALWAYS A NEW ENTRY.

                   We deliberately do NOT compare with 31-MAR
                   to determine the type.

                   If either yesterday or today has a balance,
                   start a new financial-year tracking entry.
                   ================================================= */

                WHEN EXTRACT(MONTH FROM l_run_date) = 4
                 AND EXTRACT(DAY   FROM l_run_date) = 1
                 AND (
                        NVL(bc.t_bal, 0) <> 0
                     OR NVL(bc.y_bal, 0) <> 0
                 )

                THEN 'NEW_ENTRY'


                /* =================================================
                   NORMAL NEW ENTRY

                   Yesterday = 0
                   Today != 0
                   ================================================= */

                WHEN NVL(bc.y_bal, 0) = 0
                 AND NVL(bc.t_bal, 0) <> 0

                THEN 'NEW_ENTRY'


                /* =================================================
                   DIFFERENCE

                   Yesterday != 0
                   Today != 0
                   Balance changed OR INR balance changed
                   ================================================= */

                WHEN NVL(bc.y_bal, 0) <> 0
                 AND NVL(bc.t_bal, 0) <> 0
                 AND (
                        bc.y_bal <> bc.t_bal
                     OR bc.y_inr_bal <> bc.t_inr_bal
                 )

                THEN 'DIFFERENCE'


                /* =================================================
                   CLOSED

                   Yesterday != 0
                   Today = 0
                   ================================================= */

                WHEN NVL(bc.y_bal, 0) <> 0
                 AND NVL(bc.t_bal, 0) = 0

                THEN 'CLOSED'


                /* =================================================
                   ZERO DIFFERENCE

                   Yesterday != 0
                   Today != 0
                   Balance is unchanged
                   ================================================= */

                WHEN NVL(bc.y_bal, 0) <> 0
                 AND NVL(bc.t_bal, 0) <> 0
                 AND bc.y_bal = bc.t_bal

                THEN 'ZERO_DIFFERENCE'


                /* =================================================
                   IGNORE
                   ================================================= */

                ELSE 'IGNORE'

            END AS type

        FROM balance_compare bc
    ),


    /* ============================================================
       6. GET EXISTING FIRST ERROR DATE

       Only used during normal days.

       For 01-Apr, this information will deliberately be ignored.
       ============================================================ */

    existing_data AS
    (
        SELECT

            st.branch_code,
            st.currency,
            st.cgl,

            st.first_error_date

        FROM suspense_tracker st

        WHERE st.balance_date >= l_yesterday
          AND st.balance_date <  l_yesterday + 1
    )


    /* ============================================================
       7. FINAL RESULT
       ============================================================ */

    SELECT

        /* ========================================================
           BALANCE DATE
           ======================================================== */

        l_run_date AS balance_date,


        td.branch_code,
        td.currency,
        td.cgl,


        /* ========================================================
           TODAY'S BALANCE

           Missing today record = 0
           ======================================================== */

        NVL(td.t_bal, 0) AS balance,

        NVL(td.t_inr_bal, 0) AS inr_balance,


        /* ========================================================
           TYPE
           ======================================================== */

        td.type,


        /* ========================================================
           FIRST ERROR DATE
           ======================================================== */

        CASE

            /* ====================================================
               FINANCIAL YEAR START

               01-Apr always starts a new error cycle.

               Therefore:
                   FIRST_ERROR_DATE = 01-Apr

               We do NOT use the 31-Mar FIRST_ERROR_DATE.
               ==================================================== */

            WHEN EXTRACT(MONTH FROM l_run_date) = 4
             AND EXTRACT(DAY   FROM l_run_date) = 1
             AND (
                    NVL(td.t_bal, 0) <> 0
                 OR NVL(td.y_bal, 0) <> 0
             )

            THEN l_run_date


            /* ====================================================
               NORMAL NEW ENTRY

               Always starts error date today.
               ==================================================== */

            WHEN td.type = 'NEW_ENTRY'

            THEN l_run_date


            /* ====================================================
               EXISTING ERROR

               Keep the original FIRST_ERROR_DATE.

               If there is no previous value, start today.
               ==================================================== */

            WHEN td.type IN
            (
                'DIFFERENCE',
                'ZERO_DIFFERENCE',
                'CLOSED'
            )

            THEN NVL(
                ed.first_error_date,
                l_run_date
            )

        END AS first_error_date


    FROM typed_data td


    /* ============================================================
       JOIN EXISTING TRACKER DATA
       ============================================================ */

    LEFT JOIN existing_data ed

        ON  ed.branch_code = td.branch_code
        AND ed.currency    = td.currency
        AND ed.cgl         = td.cgl


    /* ============================================================
       REMOVE IGNORE RECORDS
       ============================================================ */

    WHERE td.type <> 'IGNORE';


    /* ============================================================
       8. COMMIT
       ============================================================ */

    COMMIT;


EXCEPTION

    WHEN OTHERS THEN

        ROLLBACK;

        RAISE_APPLICATION_ERROR(
            -20002,
            'Error in PRC_POPULATE_SUSPENSE_TRACKER: '
            || SQLERRM
        );

END PRC_POPULATE_SUSPENSE_TRACKER;
/
