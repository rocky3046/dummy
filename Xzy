WITH base AS (SELECT
        coalesce(a.cgl, b.cgl) as CGL,
        a.rpt as NWSA_AVAILABLE,
        b.rpt as BSA_AVAILABLE,
        a.HEAD_CODE as nwsa_code,
        b.head_code as bsa_code
    FROM (
        SELECT CGL, 'n' as rpt, max(HEAD_CODE) || '/' || min(HEAD_CODE) as HEAD_CODE
        FROM rb_parsed_template
        WHERE run_id IN ('nwsa_report') AND (HEAD_CODE LIKE 'A%' OR HEAD_CODE LIKE 'L%')
        GROUP BY CGL HAVING count(1) > 1
        UNION ALL
        SELECT CGL, 'n' as rpt, max(HEAD_CODE) as HEAD_CODE
        FROM rb_parsed_template
        WHERE run_id IN ('nwsa_report') AND (HEAD_CODE LIKE 'A%' OR HEAD_CODE LIKE 'L%')
        GROUP BY CGL HAVING count(1) = 1
    ) a
    FULL OUTER JOIN (
        SELECT CGL, substr(run_id, 1, 1) rpt, min(HEAD_CODE) as HEAD_CODE
        FROM rb_parsed_template
        WHERE run_id IN ('pnl_report', 'ysa_report')
        GROUP BY substr(run_id, 1, 1), CGL HAVING count(1) = 1
        UNION ALL
        SELECT CGL, 'y' rpt, min(HEAD_CODE) || '/' || max(HEAD_CODE) as HEAD_CODE
        FROM rb_parsed_template
        WHERE run_id IN ('ysa_report')
        GROUP BY CGL HAVING count(1) > 1
    ) b ON a.cgl = b.cgl
),
gl_daily AS (
    -- Get distinct CGLs for the current day
    
    SELECT DISTINCT cgl
    FROM gl_balance
    WHERE trunc(balance_date) = TO_DATE('31-03-2026', 'DD-MM-YYYY')
),
unmapped_nwsa AS (
    SELECT cgl, 'Unmapped in NWSA' AS reason
    FROM gl_daily gl
    WHERE cgl  NOT LIKE '5%'
      AND NOT EXISTS (SELECT 1 FROM base b WHERE b.CGL = gl.cgl AND b.NWSA_AVAILABLE = 'n')
),
unmapped_ysa AS (
    SELECT cgl, 'Unmapped in YSA' AS reason
    FROM gl_daily gl
    WHERE cgl  NOT LIKE '5%'
      AND cgl  NOT LIKE '7%'
      AND cgl  NOT LIKE '8%'
      AND NOT EXISTS (SELECT 1 FROM base b WHERE b.CGL = gl.cgl AND b.BSA_AVAILABLE = 'y')
),
unmapped_pnl AS (
    SELECT cgl, 'Unmapped in PNL' AS reason
    FROM gl_daily gl
    WHERE cgl  LIKE '7%' OR (cgl  LIKE '8%')
      AND NOT EXISTS (SELECT 1 FROM base b WHERE b.CGL = gl.cgl AND b.BSA_AVAILABLE = 'p')
),
all_unmapped AS (
    SELECT * FROM unmapped_nwsa
    UNION ALL
    SELECT * FROM unmapped_ysa
    UNION ALL
    SELECT * FROM unmapped_pnl
)

SELECT cgl, reason  FROM all_unmapped;
