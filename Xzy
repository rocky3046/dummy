            "checkpt": f"{HDFS_BASE}/checkpoint/{date_str}/cbs-chk/checkpoint",
            "manifest_filename": f"{type_lower}_{date_str}_controll_manifest.txt",
            "spark_stream_path": f"{HDFS_BASE}/DATA-LAKE/MANIFEST-FILES"
        }
