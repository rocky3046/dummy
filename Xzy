def run_pipeline_precheck(pipeline, spark, etl_date, run_id, process_run_id):
    """
    Performs physical filesystem and metadata evaluations on daily segmented folders.
    Identifies missing dates and runs focused delta migrations for target domains.
    """
    pipeline = pipeline.lower()

    logger = setup_logger(
        f"{pipeline.upper()}_PRECHECK",
        etl_date.strftime("%Y-%m-%d"),
        run_id
    )

    if pipeline == "glif":
        log_etl(spark, process_run_id, "precheck_started_glif", 1,
                "Glif Precheck Pipeline Started")
        required_date = [etl_date - timedelta(days=1), etl_date]   # Evaluate
    elif pipeline == "difference":
        log_etl(spark, process_run_id, "precheck_started_difference", 1,
                "Difference Precheck Pipeline Started")
        required_date = [etl_date - timedelta(days=1)]             # Evaluate
    else:
        raise ValueError(f"Unknown pipeline: {pipeline}")

    required_date_str =
    logger.info(f"PIPELINE      = {pipeline.upper()}")
    logger.info(f"REQUIRED_DATE = {required_date_str}")

    # Resolve baseline configurations for manifest generation
    cfg_base = paths_for_read(pipeline, etl_date, etl_date.strftime("%d-%m-%Y"))
    manifest_base = cfg_base
    manifest_file = f"{pipeline.upper()}_precheck_successfull_{run_id}_Manifest.txt"

    missing_dates =
    validated_dates =

    # ------------------------------------------------------------------
    # STEP 3 — Scan daily directories and resolve execution state
    # ------------------------------------------------------------------
    if pipeline == "glif":
        log_etl(spark, process_run_id, "glif_datalake_reading", 1, "GLIF datalake reading started")
    else:
        log_etl(spark, process_run_id, "difference_datalake_reading", 1, "DIFFERENCE datalake reading started")

    try:
        for dt in required_date:
            dt_str = dt.strftime("%d-%m-%Y")
            cfg = paths_for_read(pipeline, dt, dt_str)
            datalake_path = cfg

            logger.info(f"Checking HDFS path for date {dt_str}: {datalake_path}")

            # Directory evaluation & creation
            log_etl(spark, process_run_id, f"{pipeline}_dir_check_{dt_str}", 1, 
                    f"Checking if source dir exists: {datalake_path}")
            if not create_hdfs_dir(spark, datalake_path, logger=logger):
                log_etl(spark, process_run_id, f"{pipeline}_dir_check_{dt_str}", 3, 
                        f"Could not create or find path: {datalake_path}")
                
                # Close Spark Session before system tear-down
                if not spark._jsc.sc().isStopped():
                    spark.stop()
                sys.exit(1)
            
            log_etl(spark, process_run_id, f"{pipeline}_dir_check_{dt_str}", 2, 
                    f"Source dir exists: {datalake_path}")

            # Structural verification on daily partitioned storage targets
            if not delta_table_exists(spark, datalake_path):
                logger.info(f"Delta table log missing at {datalake_path} for date: {dt_str}. Migration required.")
                missing_dates.append(dt)
            else:
                # Target-bound data check
                delta_df = spark.read.format("delta").load(datalake_path)
                
                # Optimized short-circuit emptiness verification
                if delta_df.isEmpty():
                    logger.warning(f"Delta table exists but is empty at {datalake_path} for date: {dt_str}. Migration required.")
                    missing_dates.append(dt)
                else:
                    logger.info(f"Data verified and present for date: {dt_str}")
                    validated_dates.append(dt_str)

        logger.info(f"VALIDATED_DATES = {validated_dates}")
        logger.info(f"MISSING_DATES   = {}")

    except Exception as ex:
        logger.error("Failed to read Delta tables during validation check", exc_info=True)
        read_event = "glif_datalake_reading" if pipeline == "glif" else "difference_datalake_reading"
        log_etl(spark, process_run_id, read_event, 3, f"Error validating {pipeline.upper()} datalake")
        raise ex

    # ------------------------------------------------------------------
    # CASE A — All dates validated as present -> finalize manifest
    # ------------------------------------------------------------------
    if len(missing_dates) == 0:
        if pipeline == "glif":
            logger.info("Data present in GLIF datalake for all required dates")
            log_etl(spark, process_run_id, "glif_datalake_reading", 2, "Data present in GLIF datalake for all required dates")
            
            create_manifest(
                spark, manifest_file, manifest_base, etl_date,
                f"GLIF | DATA_ALREADY_PRESENT | DATE={required_date_str}"
            )
            logger.info("GLIF STATUS = DATA_ALREADY_PRESENT")
            log_etl(spark, process_run_id, "precheck_started_glif", 2,
                    "Glif Precheck Pipeline Completed — Data Already Present")

        elif pipeline == "difference":
            logger.info("Data present in DIFFERENCE datalake for all required dates")
            log_etl(spark, process_run_id, "difference_datalake_reading", 2, "Data present in DIFFERENCE datalake for all required dates")

            create_manifest(
                spark, manifest_file, manifest_base, etl_date,
                f"DIFFERENCE | DATA_ALREADY_PRESENT | DATE={required_date_str}"
            )
            logger.info("DIFFERENCE STATUS = DATA_ALREADY_PRESENT")
            log_etl(spark, process_run_id, "precheck_started_difference", 2,
                    "Difference Precheck Pipeline Completed — Data Already Present")

        return True

    # ------------------------------------------------------------------
    # CASE B — Target slices missing -> migrate targets selectively
    # ------------------------------------------------------------------
    try:
        failed_count = 0

        # -- GLIF migration --
        if pipeline == "glif":
            logger.info("GLIF DATA NOT PRESENT FOR SOME/ALL DATES | MIGRATION REQUIRED")
            log_etl(spark, process_run_id, "glif_datalake_reading", 3, "GLIF Data not present — migration required")
            log_etl(spark, process_run_id, "glif_migration", 1, "GLIF Migration Started")

            for dt in missing_dates:
                logger.info(f"Running GLIF migration for {dt.strftime('%d-%m-%Y')}")
                success = run_glif_migration(spark, dt, run_id, process_run_id)

                if not success:
                    failed_count += 1
                    logger.error(f"GLIF | No Oracle data for date: {dt.strftime('%d-%m-%Y')}")
                    log_etl(spark, process_run_id, "glif_migration", 3,
                            f"No Oracle data for GLIF date {dt.strftime('%d-%m-%Y')}")
                else:
                    logger.info(f"GLIF | Migration successful for {dt.strftime('%d-%m-%Y')}")

            logger.info(f"GLIF Migration loop done | failed_count = {failed_count}")

            if failed_count > 0:
                log_etl(spark, process_run_id, "glif_migration", 3,
                        f"GLIF Migration incomplete — {failed_count} date(s) had no Oracle data")
                raise RuntimeError(f"GLIF | {failed_count} date(s) missing in Oracle — manifest NOT written")

            log_etl(spark, process_run_id, "glif_migration", 2, "GLIF Migration Completed for all dates")
            logger.info("GLIF Migration Completed")

            create_manifest(
                spark, manifest_file, manifest_base, etl_date,
                f"GLIF | DATA_MIGRATED | DATE={required_date_str}"
            )
            logger.info("GLIF STATUS = DATA_MIGRATED")
            log_etl(spark, process_run_id, "precheck_started_glif", 2,
                    "Glif Precheck Pipeline Completed — Data Migrated")

        # -- DIFFERENCE migration --
        elif pipeline == "difference":
            logger.info("DIFFERENCE DATA NOT PRESENT | MIGRATION REQUIRED")
            log_etl(spark, process_run_id, "difference_datalake_reading", 3, "DIFFERENCE Data not present — migration required")
            log_etl(spark, process_run_id, "difference_migration", 1, "DIFFERENCE Migration Started")

            for dt in missing_dates:
                logger.info(f"Running DIFFERENCE migration for {dt.strftime('%d-%m-%Y')}")
                success = run_difference_migration(spark, dt, run_id, process_run_id)

                if not success:
                    failed_count += 1
                    logger.error(f"DIFFERENCE | No Oracle data for date: {dt.strftime('%d-%m-%Y')}")
                    log_etl(spark, process_run_id, "difference_migration", 3,
                            f"No Oracle data for DIFFERENCE date {dt.strftime('%d-%m-%Y')}")
                else:
                    logger.info(f"DIFFERENCE | Migration successful for {dt.strftime('%d-%m-%Y')}")

            logger.info(f"DIFFERENCE Migration loop done | failed_count = {failed_count}")

            if failed_count > 0:
                log_etl(spark, process_run_id, "difference_migration", 3,
                        f"DIFFERENCE Migration incomplete — {failed_count} date(s) had no Oracle data")
                raise RuntimeError(f"DIFFERENCE | {failed_count} date(s) missing in Oracle — manifest NOT written")

            log_etl(spark, process_run_id, "difference_migration", 2, "DIFFERENCE Migration Completed for all dates")
            logger.info("DIFFERENCE Migration Completed")

            create_manifest(
                spark, manifest_file, manifest_base, etl_date,
                f"DIFFERENCE | DATA_MIGRATED | DATE={required_date_str}"
            )
            logger.info("DIFFERENCE STATUS = DATA_MIGRATED")
            log_etl(spark, process_run_id, "precheck_started_difference", 2,
                    "Difference Precheck Pipeline Completed — Data Migrated")

    except Exception as ex:
        logger.error("MIGRATION FAILED", exc_info=True)
        migration_event = "glif_migration" if pipeline == "glif" else "difference_migration"
        log_etl(spark, process_run_id, migration_event, 3, f"Error in {pipeline.upper()} migration")
        raise ex


# =============================================================================
# 6. APPLICATION ENTRY POINT (SAFE EXECUTION BLOCK)
# =============================================================================

def main(args):
    HDFS_BASE = get_hdfs_base()
    
    # Spark instance initialization
    spark = create_spark_session("DATALAKE_PRECHECK", HDFS_BASE)
    spark.conf.set("spark.hadoop.fs.defaultFS", HDFS_BASE)

    # ------------------------------------------------------------------
    # PERFORMANCE OPTIMIZATIONS (Delta Lake Tuning)
    # ------------------------------------------------------------------
    # Prevent small-file write distribution fragmentation
    spark.conf.set("spark.databricks.delta.optimizeWrite.enabled", "true")
    # Consolidate disk writes on completion
    spark.conf.set("spark.databricks.delta.autoCompact.enabled", "true")
    # Optimize query execution pathways dynamically
    spark.conf.set("spark.sql.adaptive.enabled", "true")

    PROCESS_ID = Process.PRECHECK_PIPELINE

    etl_date = get_etl_date(spark)

    # Dynamic system ID mapping
    process_run_id = sys.argv if len(sys.argv) > 1 else get_process_run_id(
        spark, PROCESS_ID, etl_date.strftime("%Y-%m-%d"))
    pipeline_run_id = get_run_id(spark, etl_date.strftime("%Y-%m-%d"), PROCESS_ID)

    master_logger = setup_logger(
        "PRECHECK_MASTER",
        etl_date.strftime("%Y-%m-%d"),
        pipeline_run_id
    )

    master_logger.info(f"Precheck ETL Date : {etl_date}")
    master_logger.info("===== PRECHECK STARTED =====")
    
    log_etl(spark, process_run_id, "precheck_started", 1, "Precheck Pipeline Started")

    # ------------------------------------------------------------------
    # Month-end currency validation
    # ------------------------------------------------------------------
    check_monthend = check_MonthEnd()
    if check_monthend:
        master_logger.info("Month-end detected — running Currency Precheck")
        try:
            currency_ok = run_currency_precheck_monthend(
                spark, etl_date, pipeline_run_id, process_run_id)
            if not currency_ok:
                master_logger.error("Currency Precheck FAILED — aborting pipeline")
                log_etl(spark, process_run_id, "precheck_started", 3, "Aborting — Currency Precheck Failed")
                
                # Graceful deallocation of context
                if not spark._jsc.sc().isStopped():
                    spark.stop()
                sys.exit(1)
        except Exception:
            master_logger.error("Currency Precheck threw an exception — aborting", exc_info=True)
            if not spark._jsc.sc().isStopped():
                spark.stop()
            sys.exit(1)

    # ------------------------------------------------------------------
    # Sequential Pipeline Checks (GLIF & DIFFERENCE)
    # ------------------------------------------------------------------
    failed_pipeline_count = 0

    for pipeline in ["glif", "difference"]:
        try:
            run_id = get_run_id(spark, etl_date.strftime("%Y-%m-%d"), PROCESS_ID)
            run_pipeline_precheck(pipeline, spark, etl_date, run_id, process_run_id)
            master_logger.info(f"{pipeline.upper()} Precheck Pipeline Completed")
        except Exception:
            master_logger.error(f"{pipeline.upper()} PRECHECK FAILED", exc_info=True)
            failed_pipeline_count += 1

            # Log faults using descriptive stage events
            log_etl(spark, process_run_id, f"precheck_started_{pipeline}", 3, f"Error in {pipeline.upper()} Precheck Pipeline")
            log_etl(spark, process_run_id, "precheck_started", 3, f"Error in {pipeline.upper()} Precheck Pipeline")

    # ------------------------------------------------------------------
    # Status verification and cleanup
    # ------------------------------------------------------------------
    master_logger.info(
        f"===== PRECHECK FINISHED | Failed pipelines = {failed_pipeline_count} ====="
    )

    if failed_pipeline_count == 0:
        log_etl(spark, process_run_id, "precheck_started", 2, "Precheck Pipeline Completed Successfully")
        master_logger.info("===== PRECHECK COMPLETED SUCCESSFULLY =====")
        
        if not spark._jsc.sc().isStopped():
            spark.stop()
    else:
        log_etl(spark, process_run_id, "precheck_started", 3, f"Precheck Failed — {failed_pipeline_count} pipeline(s) failed")
        master_logger.error(f"===== PRECHECK FAILED | {failed_pipeline_count} pipeline(s) failed =====")
        
        if not spark._jsc.sc().isStopped():
            spark.stop()
        sys.exit(1)


if __name__ == "__main__":
    main(sys.argv)
