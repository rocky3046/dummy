def paths_for_read(type, date, today_str):
    """
    Dynamically constructs date-partitioned HDFS paths.
    Target structure: f"{HDFS_BASE}/datalake/fincore/data-lake/DD-MM-YYYY/type"
    """
    # Safeguard to ensure date is correctly formatted as DD-MM-YYYY
    if isinstance(date, (datetime, date)):
        date_str = date.strftime("%d-%m-%Y")
    else:
        date_str = today_str

    HDFS_BASE = get_hdfs_base()
    manifest_base = f"{HDFS_BASE}/ManifestFolder"
    type_lower = type.lower()

    # Route dynamically to the new path structure requested
    dynamic_precheck_path = f"{HDFS_BASE}/datalake/fincore/data-lake/{date_str}/{type_lower}"

    if type_lower == "glif":        
        return {
            "HDFS_BASE": HDFS_BASE,
            "HDFS_PATH": f"{HDFS_BASE}",
            "GL_DATALAKE_PATH": dynamic_precheck_path,
            "manifest_filename": f"{type_lower}_{date_str}_glif_balance_manifest.txt",
            "spark_stream_path": f"{HDFS_BASE}/DATA-LAKE/MANIFEST-FILES",
            "PRECHECK_DATALAKE_PATH": dynamic_precheck_path,
            "MANIFEST_BASE_PATH": manifest_base, 
        }
    elif type_lower == "bancs24":
        return {
            "HDFS_BASE": HDFS_BASE,
            "HDFS_PATH": f"{HDFS_BASE}/CBS-FILES/{date_str}/BANCS24",
            "CBS_BALANCE_DATALAKE_PATH": dynamic_precheck_path,
            "manifest_filename": f"{type_lower}_{date_str}_cbs_balance_manifest.txt",
            "spark_stream_path": f"{HDFS_BASE}/DATA-LAKE/MANIFEST-FILES/"
        }
    elif type_lower == "cbs":
        return {
            "HDFS_BASE": HDFS_BASE,
            "HDFS_PATH": f"{HDFS_BASE}/CBS-FILES/{date_str}/BANCS24",
            "CBS_BALANCE_DATALAKE_PATH": dynamic_precheck_path,
            "manifest_filename": f"{type_lower}_{date_str}_cbs_balance_manifest.txt",
            "spark_stream_path": f"{HDFS_BASE}/DATA-LAKE/MANIFEST-FILES/",
            "MANIFEST_BASE_PATH": manifest_base, 
        }
    elif type_lower == "difference":        
        return {
            "DIFFERENCE_DATALAKE_PATH": dynamic_precheck_path,
            "CBS_DATALAKE_PATH": f"{HDFS_BASE}/datalake/fincore/data-lake/{date_str}/bancs24",
            "GL_DATALAKE_PATH": f"{HDFS_BASE}/datalake/fincore/data-lake/{date_str}/glif",
            "PRECHECK_DATALAKE_PATH": dynamic_precheck_path,
            "REPORTS": f"{HDFS_BASE}/reports/diffrencereport",
            "MANIFEST_BASE_PATH": manifest_base,
        }
    elif type_lower == "controll":   
        clean_date = date_str.replace("-", "")
        formatted_date = datetime.strptime(clean_date, '%d%m%Y').strftime('%d-%m-%Y') if len(clean_date) == 8 else date_str     
        return {
            "HDFS_BASE": HDFS_BASE,     
            "HDFS_PATH": f"{HDFS_BASE}/CONTROL/{formatted_date}",
            "manifest_filename": f"{type_lower}_{date_str}_controll_manifest.txt",
            "spark_stream_path": f"{HDFS_BASE}/DATA-LAKE/MANIFEST-FILES",
            "checkpt": f"{HDFS_BASE}/checkpoint/{date_str}/controll-chk/checkpoint",
        }
    elif type_lower == "gliftotalfiles": 
        clean_date = date_str.replace("-", "")
        formatted_date = datetime.strptime(clean_date, '%d%m%Y').strftime('%d-%m-%Y') if len(clean_date) == 8 else date_str       
        return {
            "HDFS_BASE": HDFS_BASE,     
            "HDFS_PATH": f"{HDFS_BASE}/CBS-FILES/{formatted_date}/GLIF",
            "checkpt": f"{HDFS_BASE}/checkpoint/{date_str}/glif-chk/checkpoint",
            "manifest_filename": f"{type_lower}_{date_str}_controll_manifest.txt",
            "spark_stream_path": f"{HDFS_BASE}/DATA-LAKE/MANIFEST-FILES"
