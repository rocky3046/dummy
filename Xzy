CREATE OR REPLACE PROCEDURE PRC_POPULATE_SUSPENSE_TRACKER (
    p_from_date IN DATE,
    p_to_date   IN DATE
)
IS
    l_run_date  DATE;
    l_yesterday DATE;

BEGIN

    /* ============================================================
       VALIDATION
       ============================================================ */

    IF p_from_date IS NULL THEN
        RAISE_APPLICATION_ERROR(
            -20001,
            'p_from_date cannot be NULL'
        );
    END IF;

    IF p_to_date IS NULL THEN
        RAISE_APPLICATION_ERROR(
            -20002,
            'p_to_date cannot be NULL'
        );
    END IF;

    IF TRUNC(p_from_date) > TRUNC(p_to_date) THEN
        RAISE_APPLICATION_ERROR(
            -20003,
            'p_from_date cannot be greater than p_to_date'
        );
    END IF;


    /* ============================================================
       PROCESS EACH DATE
       ============================================================ */

    FOR r IN
    (
        SELECT TRUNC(p_from_date) + LEVEL - 1 AS run_date
        FROM dual
        CONNECT BY TRUNC(p_from_date) + LEVEL - 1 <= TRUNC(p_to_date)
    )
    LOOP

        l_run_date  := r.run_date;
        l_yesterday := l_run_date - 1;


        /* ========================================================
           REMOVE EXISTING RESULT FOR THIS DATE

           This makes the procedure safe to rerun for a date.
           We DO NOT delete yesterday's data because it is required
           for FIRST_ERROR_DATE processing.
           ======================================================== */

        DELETE FROM suspense_tracker
        WHERE balance_date >= l_run_date
          AND balance_date <  l_run_date + 1;


        /* ========================================================
           INSERT RESULT FOR CURRENT RUN DATE
           ======================================================== */

        INSERT INTO suspense_tracker
        (
            balance_date,
            branch_code,
            currency,
            cgl,
            balance,
            inr_balance,
            type,
            first_error_date
        )

        WITH

        /* ========================================================
           TODAY'S BALANCE
           ======================================================== */

        today_data AS
        (
            SELECT
                gb.branch_code,
                gb.currency,
                gb.cgl,

                gb.balance       AS t_bal,
                gb.inr_balance   AS t_inr_bal

            FROM gl_balance gb

            WHERE gb.balance_date >= l_run_date
              AND gb.balance_date <  l_run_date + 1

              AND gb.cgl IN
              (
                    '1111111111',
                    '1111111112',
                    '1260505001',
                    '2148505001',
                    '1148505004',
                    '1148505005',
                    '1148505006',
                    '1148505007',
                    '1148505010',
                    '1148505012',
                    '1148505014',
                    '1148505020',
                    '2148505004',
                    '2148505006',
                    '2148505007',
                    '2148505010',
                    '2148505011',
                    '2148505014',
                    '2148505016',
                    '2148505018',
                    '2148505019',
                    '2148505021',
                    '2148505022',
                    '2148505024',
                    '2148505033',
                    '2148505035',
                    '1260505002',
                    '1260505003'
              )
        ),


        /* ========================================================
           YESTERDAY'S BALANCE
           ======================================================== */

        yesterday_data AS
        (
            SELECT
                gb.branch_code,
                gb.currency,
                gb.cgl,

                gb.balance       AS y_bal,
                gb.inr_balance   AS y_inr_bal

            FROM gl_balance gb

            WHERE gb.balance_date >= l_yesterday
              AND gb.balance_date <  l_yesterday + 1

              AND gb.cgl IN
              (
                    '1111111111',
                    '1111111112',
                    '1260505001',
                    '2148505001',
                    '1148505004',
                    '1148505005',
                    '1148505006',
                    '1148505007',
                    '1148505010',
                    '1148505012',
                    '1148505014',
                    '1148505020',
                    '2148505004',
                    '2148505006',
                    '2148505007',
                    '2148505010',
                    '2148505011',
                    '2148505014',
                    '2148505016',
                    '2148505018',
                    '2148505019',
                    '2148505021',
                    '2148505022',
                    '2148505024',
                    '2148505033',
                    '2148505035',
                    '1260505002',
                    '1260505003'
              )
        ),


        /* ========================================================
           FULL OUTER JOIN
           ======================================================== */

        balance_compare AS
        (
            SELECT

                NVL(t.branch_code, y.branch_code) AS branch_code,
                NVL(t.currency,    y.currency)    AS currency,
                NVL(t.cgl,         y.cgl)         AS cgl,

                t.t_bal,
                t.t_inr_bal,

                y.y_bal,
                y.y_inr_bal

            FROM today_data t

            FULL OUTER JOIN yesterday_data y
                ON  t.branch_code = y.branch_code
                AND t.currency    = y.currency
                AND t.cgl         = y.cgl
        ),


        /* ========================================================
           TYPE LOGIC
           ======================================================== */

        typed_data AS
        (
            SELECT

                bc.*,

                CASE

                    /* --------------------------------------------
                       NEW ENTRY
                       Yesterday = 0
                       Today != 0
                       -------------------------------------------- */

                    WHEN NVL(y_bal, 0) = 0
                     AND NVL(t_bal, 0) <> 0

                    THEN 'NEW_ENTRY'


                    /* --------------------------------------------
                       DIFFERENCE

                       Yesterday != 0
                       Today != 0
                       Balance OR INR balance changed
                       -------------------------------------------- */

                    WHEN NVL(y_bal, 0) <> 0
                     AND NVL(t_bal, 0) <> 0
                     AND
                     (
                            y_bal <> t_bal
                         OR y_inr_bal <> t_inr_bal
                     )

                    THEN 'DIFFERENCE'


                    /* --------------------------------------------
                       CLOSED

                       Yesterday != 0
                       Today = 0
                       -------------------------------------------- */

                    WHEN NVL(y_bal, 0) <> 0
                     AND NVL(t_bal, 0) = 0

                    THEN 'CLOSED'


                    /* --------------------------------------------
                       ZERO DIFFERENCE

                       Yesterday != 0
                       Today != 0
                       Balance unchanged
                       -------------------------------------------- */

                    WHEN NVL(y_bal, 0) <> 0
                     AND NVL(t_bal, 0) <> 0
                     AND y_bal = t_bal

                    THEN 'ZERO_DIFFERENCE'


                    /* --------------------------------------------
                       Everything else
                       -------------------------------------------- */

                    ELSE 'IGNORE'

                END AS type

            FROM balance_compare bc
        ),


        /* ========================================================
           EXISTING FIRST ERROR DATE

           Get the previous day's tracker record.

           This is important because when we process:

             04-Apr

           we need the FIRST_ERROR_DATE generated/stored on:

             03-Apr
           ======================================================== */

        existing_data AS
        (
            SELECT
                st.branch_code,
                st.currency,
                st.cgl,
                st.first_error_date

            FROM suspense_tracker st

            WHERE st.balance_date >= l_yesterday
              AND st.balance_date <  l_yesterday + 1
        )


        /* ========================================================
           FINAL RESULT
           ======================================================== */

        SELECT

            /* Current processing date */
            l_run_date AS balance_date,

            td.branch_code,
            td.currency,
            td.cgl,

            /* Current balance */
            NVL(td.t_bal, 0) AS balance,

            NVL(td.t_inr_bal, 0) AS inr_balance,

            td.type,

            /* --------------------------------------------
               FIRST ERROR DATE LOGIC
               -------------------------------------------- */

            CASE

                /* NEW ENTRY always starts today */
                WHEN td.type = 'NEW_ENTRY'
                THEN l_run_date


                /* Existing error:
                   Keep previous FIRST_ERROR_DATE.
                   If none exists, start today.
                */
                WHEN td.type IN
                (
                    'DIFFERENCE',
                    'ZERO_DIFFERENCE',
                    'CLOSED'
                )
                THEN NVL(
                    ed.first_error_date,
                    l_run_date
                )

            END AS first_error_date

        FROM typed_data td

        LEFT JOIN existing_data ed

            ON  ed.branch_code = td.branch_code
            AND ed.currency    = td.currency
            AND ed.cgl         = td.cgl

        /* Remove IGNORE records */
        WHERE td.type <> 'IGNORE';


        /* ========================================================
           OPTIONAL:
           COMMIT AFTER EACH DAY
           
           Recommended if the date range can be large.
           ======================================================== */

        COMMIT;


    END LOOP;


EXCEPTION

    WHEN OTHERS THEN

        ROLLBACK;

        RAISE_APPLICATION_ERROR(
            -20010,
            'Error in PRC_POPULATE_SUSPENSE_TRACKER: '
            || SQLERRM
        );

END PRC_POPULATE_SUSPENSE_TRACKER;
/
